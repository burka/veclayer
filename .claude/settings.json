{
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "veclayer"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "veclayer observe",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Write|Edit|WebFetch|WebSearch|Agent"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "veclayer stale --output llm-nudge",
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "veclayer context --brief",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "veclayer context --brief",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "command -v veclayer >/dev/null 2>&1 && veclayer stale --output llm-nudge",
            "type": "command"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "veclayer": {
      "args": [
        "serve",
        "--mcp-stdio"
      ],
      "command": "veclayer"
    }
  },
  "permissions": {
    "allow": [
      "mcp__veclayer__*"
    ]
  }
}
