**P8 — `src/relations.rs`** (shared bidirectional helper):
```rust
/// Add a bidirectional relation for `related_to`.
/// When kind == RELATED_TO, also adds reverse link so navigation works both ways.
pub async fn add_bidirectional(
    store: &Arc<StoreBackend>,
    source_id: &str,
    target_id: &str,
    kind: &str,
) -> crate::Result<()> {
    store.add_relation(source_id, ChunkRelation::new(kind, target_id)).await?;
    if kind == relation::RELATED_TO {
        store.add_relation(target_id, ChunkRelation::new(kind, source_id)).await?;
    }
    Ok(())
}
```
