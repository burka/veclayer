{
  "mcpServers": {
    "veclayer": {
      "command": "veclayer",
      "args": ["serve", "--mcp-stdio"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "veclayer context --brief",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|WebFetch|WebSearch|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "veclayer observe",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Compaction imminent — persist important knowledge to veclayer now!' >&2"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "veclayer stale --output llm-nudge"
          }
        ]
      }
    ]
  }
}
